      {
        "name": "A_baseline_embbag",
        "role": "baseline",
        "type": "embbag",
        "emb_dim": 100,
        "ngram": 1,
        "hidden": 0,
        "dropout": 0.2,
        "lr": 0.005,
        "weight_decay": 0.0,
        "batch_size": 512,
        "epochs": 5,
        "patience": 2,
        "why": "Bag of learned word embeddings (fastText-style, unigrams only). It is the simplest model that still learns embeddings, it trains in about a minute, and it sets a lower bound. Anything more complex must beat it, otherwise the added word-order modelling is not paying for itself."
      },
      {
        "name": "A_exp1_textcnn",
        "role": "experimental",
        "type": "textcnn",
        "emb_dim": 128,
        "kernels": [
          3,
          4,
          5
        ],
        "filters": 128,
        "dropout": 0.5,
        "lr": 0.001,
        "weight_decay": 0.0001,
        "batch_size": 256,
        "epochs": 4,
        "patience": 2,
        "why": "Changes the ARCHITECTURE: convolutions of width 3/4/5 learn local phrase detectors ('not worth it', 'will be back'), which the bag model cannot represent. Max-over-time pooling makes a phrase count wherever it appears. Dropout 0.5 follows Kim (2014)."
      },
      {
        "name": "A_exp2_bilstm_attn",
        "role": "experimental",
        "type": "bilstm_attn",
        "emb_dim": 128,
        "hidden": 128,
        "layers": 1,
        "dropout": 0.3,
        "lr": 0.001,
        "weight_decay": 0.0001,
        "batch_size": 256,
        "epochs": 4,
        "patience": 2,
        "why": "Changes the ARCHITECTURE again: a bidirectional LSTM reads the whole review in order, so it can carry negation and contrast ('good food but awful service') across long spans. Attention pooling learns which positions matter, and its weights are inspectable during error review."
      }
    ]
